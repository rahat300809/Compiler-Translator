{
  "name": "compiler-translator",
  "displayName": "Compiler Translator — AI Error Explainer",
  "description": "Auto-detects errors in ANY terminal/run output and instantly explains them in plain language using Groq AI. Zero config — works in every folder automatically.",
  "version": "2.0.0",
  "publisher": "rahat300809",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Debuggers", "Linters"],
  "keywords": [
    "error explainer", "ai", "groq", "compiler", "terminal",
    "debug", "python", "javascript", "c++", "java", "auto"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "compilerTranslator.explainTerminal",
        "title": "🤖 Explain Terminal Output",
        "category": "Compiler Translator"
      },
      {
        "command": "compilerTranslator.configure",
        "title": "⚙️ Configure API Keys",
        "category": "Compiler Translator"
      },
      {
        "command": "compilerTranslator.clearHistory",
        "title": "🗑️ Clear Buffer",
        "category": "Compiler Translator"
      }
    ],
    "configuration": {
      "title": "Compiler Translator",
      "properties": {
        "compilerTranslator.autoExplain": {
          "type": "boolean",
          "default": true,
          "description": "Automatically explain errors when detected — works in ALL folders with zero setup"
        },
        "compilerTranslator.autoRunOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run and check the file every time you save it"
        },
        "compilerTranslator.groqApiKeys": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Your own Groq API keys (optional — 3 built-in keys already included)"
        },
        "compilerTranslator.groqModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "enum": [
            "llama-3.3-70b-versatile",
            "llama-3.1-8b-instant",
            "mixtral-8x7b-32768",
            "gemma2-9b-it"
          ],
          "description": "Groq AI model to use"
        },
        "compilerTranslator.enableFirebase": {
          "type": "boolean",
          "default": true,
          "description": "Log error sessions to Firebase"
        },
        "compilerTranslator.language": {
          "type": "string",
          "default": "English",
          "enum": ["English", "Bangla", "Spanish", "French", "Hindi", "Arabic"],
          "description": "Language for AI explanations"
        },
        "compilerTranslator.terminalCaptureDelay": {
          "type": "number",
          "default": 800,
          "description": "Milliseconds to wait after terminal output settles before analyzing (lower = faster but may miss multi-line errors)"
        }
      }
    },
    "keybindings": [
      {
        "command": "compilerTranslator.explainTerminal",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ],
    "menus": {
      "terminal/context": [
        {
          "command": "compilerTranslator.explainTerminal",
          "group": "z_compilerTranslator"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "firebase": "^10.7.0",
    "groq-sdk": "^0.3.3",
    "node-fetch": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rahat300809/Compiler-Translator.git"
  },
  "license": "MIT"
}
